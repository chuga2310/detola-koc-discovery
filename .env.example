# ---- AI provider ----
# Không set AI_PROVIDER: tự chọn anthropic nếu có ANTHROPIC_API_KEY, openai nếu có OPENAI_API_KEY, còn lại mock.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AI_PROVIDER=anthropic   # anthropic | openai | mock

# Model tiering (mặc định cho anthropic): screen=claude-haiku-5-5, video=claude-sonnet-5-5, final=claude-opus-5-5
# MODEL_SCREEN=claude-haiku-5-5
# MODEL_VIDEO=claude-sonnet-5-5
# MODEL_FINAL=claude-opus-5-5
# EFFORT_SCREEN=low
# EFFORT_VIDEO=low
# EFFORT_FINAL=medium
# ANTHROPIC_FALLBACKS=on   # server-side refusal fallback cho Opus/Sonnet

# ---- Data: Kalodata Open API (https://www.kalodata.com/open-center/docs) ----
KALODATA_API_KEY=
DATA_SOURCE=kalodata               # kalodata | fixture (data mẫu offline: npm run gen:fixtures)
# KALODATA_MAX_CREDITS_PER_RUN=12  # trần credit mỗi run (1 credit ~ $0.1)
# KALODATA_VIDEO_URL_FALLBACK=primary   # primary | all | off  (video/url = 0.5 credit / video)
# KALODATA_CACHE_TTL_HOURS=72

# ---- Runtime ----
# AI_CONCURRENCY=4
# MEDIA_CONCURRENCY=3
# MAX_TASK_ATTEMPTS=3
# USD_VND=26000
# DB_PATH=.data/koc.db
# MEDIA_CACHE_DIR=.data/media
# YT_DLP_BIN=yt-dlp
